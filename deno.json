{
  "name": "@moonlight/ui",
  "version": "0.0.1",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts"
  },
  "tasks": {
    "test": "deno test --allow-read --allow-net src/",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "gallery": "deno run --allow-read --allow-net gallery/serve.ts"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "dom", "dom.iterable"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/http": "jsr:@std/http@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/media-types": "jsr:@std/media-types@^1.0.0",
    "deno_dom": "jsr:@b-fuze/deno-dom@^0.1.49"
  },
  "fmt": {
    "exclude": ["dist/", ".git/"]
  },
  "lint": {
    "exclude": ["dist/", ".git/"]
  }
}
